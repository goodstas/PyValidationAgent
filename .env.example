GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
# Required. Use the exact Vertex model ID your probe verified (README section 1); the plan proposes gemini-3.5-flash.
GEMINI_MODEL=REPLACE_WITH_VERIFIED_MODEL_ID
REPO_ROOT=./demo/DemoShop
STATE_DIR=~/.secureyourcode-state
SCAN_TIMEOUT_SECONDS=300
MAX_REVIEW_CANDIDATES=16
SERVICE_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
ALLOW_UNAUTHENTICATED_LOOPBACK=false
