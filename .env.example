# Model provider: vertex (plan default: Gemini on Vertex AI via ADC) or anthropic (Claude via the Anthropic API).
MODEL_PROVIDER=vertex
# For MODEL_PROVIDER=anthropic: the model ID, e.g. claude-sonnet-5-5. The API key is read ONLY from the process
# environment variable ANTHROPIC_API_KEY (never put it in this file).
ANTHROPIC_MODEL=claude-sonnet-5-5
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
# Required. Use the exact Vertex model ID your probe verified (README section 1); the plan proposes gemini-3.5-flash.
GEMINI_MODEL=REPLACE_WITH_VERIFIED_MODEL_ID
REPO_ROOT=./demo/DemoShop
STATE_DIR=~/.secureyourcode-state
SCAN_TIMEOUT_SECONDS=300
MAX_REVIEW_CANDIDATES=16
SERVICE_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
ALLOW_UNAUTHENTICATED_LOOPBACK=false
# Explicit opt-in for anonymous container/public MCP access. SERVICE_TOKEN still takes precedence.
ALLOW_UNAUTHENTICATED_PUBLIC=false
# Public host[:port] accepted by MCP; HTTPS origins are supported, DNS-rebinding protection remains on.
MCP_ALLOWED_HOSTS=
